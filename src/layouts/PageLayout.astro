---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { t, langLabels, type LocaleKey, type Lang } from '../data/translations';
import type { SeoPageKey } from '../data/seo';
import type { Artwork } from '../data/artworks';
import { imageSeoSlots } from '../data/image-seo-slots';
import { seoCopy } from '../data/seo-copy';

export interface Props {
  title: string;
  activeSection?: string;
  locale?: LocaleKey;
  /** SEO logical page — drives meta + JSON-LD. Defaults to home. */
  seoPage?: SeoPageKey;
  seoDescription?: string;
  /** TODO(client-images): pending final image approval */
  ogImage?: string | null;
  artwork?: Artwork;
}

const {
  title,
  activeSection = '',
  locale = 'en',
  seoPage = 'home',
  seoDescription,
  ogImage = imageSeoSlots.defaultOgImage,
  artwork,
} = Astro.props;
const l = t[locale];
const langList: Lang[] = ['en', 'kr', 'kk', 'zh', 'ru'];
const tabSeoIsland = seoPage === 'home' || seoPage === 'about' ? seoCopy[locale] : null;

// Derive active language from URL pathname — reliable across all routes and ClientRouter
const pathSeg = Astro.url.pathname.split('/')[1];
const activeLang = pathSeg && langList.includes(pathSeg as Lang) ? (pathSeg as Lang) : 'en';

function isActiveLang(lang: string): boolean {
  if (lang === 'en') return activeLang === 'en';
  return activeLang === lang;
}

const homePath = locale === 'en' ? '/' : `/${locale}`;

const menuItems: { key: string; href: string }[] = [
  { key: "about", href: `${homePath}#about` },
  { key: "art", href: `${homePath}#art` },
  { key: "exhibitions", href: `${homePath}#exhibitions` },
  { key: "publications", href: `${homePath}#publications` },
  { key: "research", href: `${homePath}#research` },
  { key: "press", href: `${homePath}#press` },
  { key: "contacts", href: `${homePath}#contacts` },
];
---

<!doctype html>
<html lang={l.lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F0EEE9" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('site-theme');
          var resolvedTheme = theme === 'dark' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', resolvedTheme);
          var colorSchemeMeta = document.querySelector('meta[name="color-scheme"]');
          if (colorSchemeMeta) {
            colorSchemeMeta.setAttribute('content', resolvedTheme);
          }
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
          var colorSchemeMeta = document.querySelector('meta[name="color-scheme"]');
          if (colorSchemeMeta) {
            colorSchemeMeta.setAttribute('content', 'light');
          }
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO
      locale={locale}
      page={seoPage}
      title={seoPage === 'artwork' ? title : undefined}
      description={seoDescription}
      ogImage={ogImage}
      artwork={artwork}
    />
    {tabSeoIsland && (
      <script type="application/json" id="seo-meta-by-tab" set:html={JSON.stringify(tabSeoIsland)} />
    )}
    <!-- tabular-v1: sidebar tabs, instant panel swap -->
    <ClientRouter />
    <script is:inline>
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        document.documentElement.classList.add("motion-live");
      })();
    </script>
  </head>
  <body class="font-body antialiased bg-[var(--canvas)] text-[var(--ink)]" data-layout="scroll">
    <!-- Film grain overlay -->
    <div class="grain-overlay" />

    <!-- Floating island navigation -->
    <nav class="v2-nav" aria-label={l.siteNavAria}>
      <div class="v2-nav__island">
        <a href={`${homePath}#home`} class="v2-nav__brand" data-nav-key="home">{l.siteTitle}</a>
        <ul class="v2-nav__links">
          {menuItems.map((item) => {
            const navKey = item.key as keyof typeof l.nav;
            return (
              <li>
                <a
                  href={item.href}
                  data-nav-key={item.key}
                  id={`nav-${item.key}`}
                  class="v2-nav__link"
                  aria-current={item.key === "about" ? "true" : "false"}
                >
                  {l.nav[navKey]}
                </a>
              </li>
            );
          })}
        </ul>
        <div class="v2-nav__actions">
          <div id="lang-toggle-desktop" class="lang-toggle lang-toggle--desktop hidden lg:flex">
            {langList.map((lang) => (
              <button
                type="button"
                class:list={["lang-btn", isActiveLang(lang) && "lang-btn--active"]}
                data-lang={lang}
                aria-pressed={isActiveLang(lang) ? 'true' : 'false'}
                aria-label={`${l.switchToLangAria} ${langLabels[lang]}`}
              >
                <span class="lang-btn__label">{langLabels[lang]}</span>
              </button>
            ))}
          </div>
          <div class="hidden lg:block">
            <ThemeToggle locale={locale} />
          </div>
          <button
            type="button"
            id="v2-menu-btn"
            class="v2-nav__menu-btn"
            aria-label={l.toggleMenuAria}
            aria-expanded="false"
            aria-controls="v2-menu"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path class="ham-open" stroke-linecap="round" d="M4 8h16M4 16h16" />
              <path class="ham-close hidden" stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </div>
      </div>
    </nav>

    <div id="v2-menu" class="v2-menu lg:hidden" aria-hidden="true">
      <ul class="v2-menu__list">
        {menuItems.map((item) => {
          const navKey = item.key as keyof typeof l.nav;
          return (
            <li>
              <a href={item.href} data-nav-key={item.key} class="v2-menu__link">
                {l.nav[navKey]}
              </a>
            </li>
          );
        })}
      </ul>
      <div class="v2-menu__meta">
        <div class="mb-5">
          <span class="block mb-2 text-[11px] uppercase tracking-[0.25em] text-[var(--ink-muted)]">{l.themeLabel}</span>
          <ThemeToggle locale={locale} />
        </div>
        <span class="block mb-1 text-[11px] uppercase tracking-[0.25em] text-[var(--ink-muted)]">{l.basedIn}</span>
        <span class="block mb-5">{l.location}</span>
        <span class="block mb-2 text-[11px] uppercase tracking-[0.25em] text-[var(--ink-muted)]">{l.languageLabel}</span>
        <div id="lang-toggle-mobile" class="lang-toggle lang-toggle--drawer">
          {langList.map((lang) => (
            <button
              type="button"
              class:list={["lang-btn", isActiveLang(lang) && "lang-btn--active"]}
              data-lang={lang}
              aria-pressed={isActiveLang(lang) ? 'true' : 'false'}
              aria-label={`${l.switchToLangAria} ${langLabels[lang]}`}
            >
              <span class="lang-btn__label">{langLabels[lang]}</span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Language switch transition (persists across ClientRouter swaps) -->
    <div id="lang-transition-overlay" class="lang-transition-overlay" transition:persist="lang-overlay" aria-hidden="true" aria-live="polite">
      <div class="lang-transition-overlay__panel">
        <span class="lang-transition-overlay__eyebrow font-mono text-[10px] tracking-[0.35em] uppercase text-[var(--ink-muted)]/70">{l.languageLabel}</span>
        <p class="lang-transition-overlay__code type-subheading text-6xl md:text-7xl text-[var(--ink)] leading-none" data-lang-code>EN</p>
        <p class="lang-transition-overlay__name type-body text-xl md:text-2xl text-[var(--ink-muted)] mt-3" data-lang-name>English</p>
        <div class="lang-transition-overlay__bar" aria-hidden="true">
          <span class="lang-transition-overlay__bar-fill"></span>
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var LANG = {
          en: { code: "EN", name: "English" },
          kr: { code: "KR", name: "한국어" },
          kk: { code: "KK", name: "Қазақша" },
          zh: { code: "简", name: "中文" },
          ru: { code: "RU", name: "Русский" },
        };
        var switching = false;

        function currentLang() {
          var seg = location.pathname.split("/")[1];
          var langs = ["kr", "kk", "zh", "ru"];
          return langs.indexOf(seg) >= 0 ? seg : "en";
        }

        function showOverlay(lang) {
          var overlay = document.getElementById("lang-transition-overlay");
          var display = LANG[lang] || { code: lang.toUpperCase(), name: lang };
          var codeEl = overlay && overlay.querySelector("[data-lang-code]");
          var nameEl = overlay && overlay.querySelector("[data-lang-name]");
          var barFill = overlay && overlay.querySelector(".lang-transition-overlay__bar-fill");
          if (codeEl) codeEl.textContent = display.code;
          if (nameEl) nameEl.textContent = display.name;
          if (barFill) {
            barFill.style.animation = "none";
            void barFill.offsetWidth;
            barFill.style.animation = "";
          }
          if (overlay) {
            overlay.classList.add("is-active");
            overlay.setAttribute("aria-hidden", "false");
          }
          document.documentElement.classList.add("lang-switching");
          document.body.classList.add("lang-switching");
        }

        window.__showLangOverlay = showOverlay;

        document.addEventListener(
          "click",
          function (e) {
            var btn = e.target && e.target.closest ? e.target.closest(".lang-btn") : null;
            if (!btn) return;
            var lang = btn.getAttribute("data-lang");
            if (!lang || lang === currentLang()) {
              e.preventDefault();
              return;
            }
            if (switching) {
              e.preventDefault();
              return;
            }

            e.preventDefault();
            e.stopImmediatePropagation();
            switching = true;

            var href = lang === "en" ? "/" : "/" + lang;
            sessionStorage.setItem("lang-preserve-tab", location.hash.replace("#", "") || "about");
            sessionStorage.setItem("lang-switching", "1");
            showOverlay(lang);

            setTimeout(function () {
              window.location.assign(href);
            }, 1500);
          },
          true
        );
      })();
    </script>

    <div class="site-shell min-h-screen">
      <div class="site-main-column min-w-0">
        <main class="motion-main">
          <slot name="content" />
        </main>
        <SiteFooter locale={locale} />
      </div>
    </div>
  </body>
</html>

<script>
  import { initMotion } from "../scripts/motion/init";
  import { initLangSwitch, syncLangHrefs, syncLangToggle, restoreLangScroll } from "../scripts/lang-switch";
  import { resetGlobalLightbox } from "../scripts/lightbox";
  import { initArtworkParallax } from "../scripts/artwork-parallax";
  import { initThemeToggle } from "../scripts/theme";

  function initV2Menu() {
    const btn = document.getElementById("v2-menu-btn");
    const menu = document.getElementById("v2-menu");
    if (!btn || !menu || btn.dataset.menuBound === "true") return;
    btn.dataset.menuBound = "true";
    const hamOpen = btn.querySelector(".ham-open");
    const hamClose = btn.querySelector(".ham-close");
    let open = false;

    const setOpen = (next: boolean) => {
      open = next;
      menu.classList.toggle("is-open", open);
      menu.setAttribute("aria-hidden", open ? "false" : "true");
      btn.setAttribute("aria-expanded", open ? "true" : "false");
      hamOpen?.classList.toggle("hidden", open);
      hamClose?.classList.toggle("hidden", !open);
      document.body.style.overflow = open ? "hidden" : "";
    };

    btn.addEventListener("click", () => setOpen(!open));
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && open) setOpen(false);
    });
  }

  function bootPageScripts() {
    document.documentElement.classList.add("motion-live");
    initV2Menu();
    syncLangHrefs();
    syncLangToggle();
    initLangSwitch();
    initMotion();
    initArtworkParallax();
    initThemeToggle();
    restoreLangScroll();
  }

  document.addEventListener("astro:after-swap", () => {
    document.querySelectorAll("[data-drawer-bound]").forEach((el) => {
      delete (el as HTMLElement).dataset.drawerBound;
    });
    document.querySelectorAll("[data-carousel-bound]").forEach((el) => {
      delete (el as HTMLElement).dataset.carouselBound;
    });
    document.querySelectorAll("[data-accordion-motion]").forEach((el) => {
      delete (el as HTMLElement).dataset.accordionMotion;
    });
    document.querySelectorAll("[data-nav-hover]").forEach((el) => {
      delete (el as HTMLElement).dataset.navHover;
    });
    document.querySelectorAll("[data-tab-bound]").forEach((el) => {
      delete (el as HTMLElement).dataset.tabBound;
    });
    document.querySelectorAll("[data-theme-bound]").forEach((el) => {
      delete (el as HTMLElement).dataset.themeBound;
    });
    document.querySelectorAll("[data-menu-bound]").forEach((el) => {
      delete (el as HTMLElement).dataset.menuBound;
    });
    resetGlobalLightbox();
    bootPageScripts();
  });

  document.addEventListener("DOMContentLoaded", bootPageScripts);

  document.addEventListener("astro:page-load", bootPageScripts);

  if (document.readyState !== "loading") {
    bootPageScripts();
  }
</script>

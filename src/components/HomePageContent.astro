---
import AboutPanelStack from './AboutPanelStack.astro';
import ArtSection from './sections/ArtSection.astro';
import ExhibitionsSection from './sections/ExhibitionsSection.astro';
import PublicationsSection from './sections/PublicationsSection.astro';
import ResearchSection from './sections/ResearchSection.astro';
import PressSection from './sections/PressSection.astro';
import ContactsSection from './sections/ContactsSection.astro';
import { type LocaleKey } from '../data/translations';

interface Props {
  locale: LocaleKey;
}

const { locale } = Astro.props;
---

<div class="v2-shell" data-scroll-view>
  <section class="v2-panel" id="panel-about" data-chapter="about">
    <AboutPanelStack locale={locale} />
  </section>

  <section class="v2-panel" id="panel-art" data-chapter="art">
    <ArtSection locale={locale} />
  </section>

  <section class="v2-panel v2-exhibitions" id="panel-exhibitions" data-chapter="exhibitions">
    <ExhibitionsSection locale={locale} />
  </section>

  <section class="v2-panel" id="panel-publications" data-chapter="publications">
    <PublicationsSection locale={locale} />
  </section>

  <section class="v2-panel research-panel" id="panel-research" data-chapter="research">
    <div class="research-panel__art" aria-hidden="true">
      <img
        src="/media/anna-sample-4.png"
        alt=""
        class="research-panel__art-img"
        loading="lazy"
        decoding="async"
        draggable="false"
        data-lightbox-ignore
        data-artwork-parallax
        data-artwork-strength="0.03"
        data-artwork-max="15"
      />
    </div>
    <ResearchSection locale={locale} />
  </section>

  <section class="v2-panel" id="panel-press" data-chapter="press">
    <PressSection locale={locale} />
  </section>

  <section class="v2-panel contacts-panel v2-contact" id="panel-contacts" data-chapter="contacts">
    <div class="contacts-panel__art" aria-hidden="true">
      <img
        src="/media/anna sample 7.png"
        alt=""
        class="contacts-panel__art-img"
        loading="lazy"
        decoding="async"
        draggable="false"
        data-lightbox-ignore
        data-artwork-parallax
        data-artwork-strength="0.04"
        data-artwork-max="20"
      />
    </div>
    <ContactsSection locale={locale} />
  </section>
</div>

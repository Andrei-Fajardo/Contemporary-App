---
import { t, type LocaleKey } from '../../data/translations';

interface Props {
  locale?: LocaleKey;
}

const { locale = 'en' } = Astro.props;
const l = t[locale];
---

<section id="about" class="v2-chapter scroll-section">
  <div class="v2-wrap">
    <p class="v2-kicker scroll-reveal">{l.aboutTag}</p>
    <h2 class="v2-title scroll-reveal">
      {l.heroIntroBefore}<em class="not-italic opacity-70">{l.heroIntroCity}</em>{l.heroIntroAfter}
    </h2>

    <div class="v2-about__grid" style="margin-top: clamp(2.5rem, 6vh, 4.5rem);">
      <p class="v2-about__bio scroll-reveal">{l.bioExpanded}</p>

      <aside class="v2-about__aside">
        <div class="v2-about__card scroll-reveal">
          <h3>{l.influencesLabel}</h3>
          <p>{l.aboutInfluencesProse}</p>
        </div>
        <div class="v2-about__card scroll-reveal">
          <h3>{l.interestsLabel}</h3>
          <p>{l.aboutInterestsProse}</p>
        </div>
      </aside>
    </div>
  </div>
</section>

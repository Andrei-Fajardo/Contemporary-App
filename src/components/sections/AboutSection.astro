---
import { t, type LocaleKey } from '../../data/translations';

interface Props {
  locale?: LocaleKey;
}

const { locale = 'en' } = Astro.props;
const l = t[locale];
const interestsInfluences = [...l.interests, ...l.influences];
---

<section id="about" class="scroll-section about-chaos about-panel-stack__content">
  <div class="section-shell section-shell--wide about-panel-stack__content-inner editorial-about">
    <header class="editorial-about__masthead scroll-reveal">
      <p class="editorial-about__label">{l.aboutTag}</p>
      <p class="editorial-about__based">{l.heroBasedIn}</p>
    </header>

    <div class="editorial-about__body">
      <h2 class="editorial-about__lead scroll-reveal">
        {l.heroIntroBefore}<span class="about-chaos__city" tabindex="0">{l.heroIntroCity}</span>{l.heroIntroAfter}
      </h2>

      <p class="editorial-about__bio content-prose scroll-reveal">{l.bio}</p>

      {interestsInfluences.length > 0 && (
        <div class="editorial-about__meta scroll-reveal">
          <p class="editorial-about__meta-label">{l.interestsInfluencesLabel}</p>
          <p class="editorial-about__meta-text">
            {interestsInfluences.join(' · ')}
          </p>
        </div>
      )}
    </div>
  </div>
</section>

---
import { t, type LocaleKey } from '../../data/translations';

interface Props {
  locale?: LocaleKey;
}

const { locale = 'en' } = Astro.props;
const l = t[locale];
---

<section id="about" class="scroll-section about-chaos about-panel-stack__content magazine-torn">
  <div class="section-shell section-shell--wide about-panel-stack__content-inner">
    <p class="pubs-editorial__label about-chaos__label scroll-reveal">{l.aboutTag}</p>

    <div class="about-editorial-spread">
      <div class="about-editorial-spread__bio scroll-reveal">
        <p class="content-prose text-ink-70 mb-2 about-chaos__subtitle">{l.heroBasedIn}</p>
        <h2 class="type-magazine-display text-2xl md:text-4xl lg:text-[2.75rem] text-ink mb-4 leading-[1.05]">
          {l.heroIntroBefore}<span class="about-chaos__city" tabindex="0">{l.heroIntroCity}</span>{l.heroIntroAfter}
        </h2>
        <p class="content-prose text-ink-75 magazine-dropcap max-w-[72ch]">{l.bioExpanded}</p>
      </div>

      <aside class="about-editorial-spread__aside scroll-reveal">
        <p class="section-eyebrow mb-3">{l.influencesLabel}</p>
        <p class="content-prose text-ink-75 about-editorial-spread__prose">{l.aboutInfluencesProse}</p>
        <p class="section-eyebrow mb-3 mt-8">{l.interestsLabel}</p>
        <p class="content-prose text-ink-75 about-editorial-spread__prose">{l.aboutInterestsProse}</p>
      </aside>
    </div>
  </div>
</section>

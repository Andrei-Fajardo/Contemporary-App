---
import EditorialLinkList from '../EditorialLinkList.astro';
import EditorialListContainer from '../EditorialListContainer.astro';
import { pressLinks } from '../../data/content';
import { t, type LocaleKey } from '../../data/translations';

interface Props {
  locale?: LocaleKey;
}

const { locale = 'en' } = Astro.props;
const l = t[locale];
---

<section id="press" class="v2-chapter scroll-section press-overlap">
  <div class="press-overlap__frame v2-scale-media" aria-hidden="true">
    <img
      src="/media/anna sample 6.png"
      alt=""
      class="press-overlap__img"
      loading="lazy"
      decoding="async"
      draggable="false"
      data-lightbox-ignore
      data-artwork-parallax
      data-artwork-strength="0.035"
      data-artwork-max="18"
    />
  </div>

  <div class="press-overlap__content">
    <div class="mb-8 md:mb-10">
      <h2 class="v2-title scroll-reveal press-overlap__heading">
        {l.nav.press}
      </h2>
    </div>
    <EditorialListContainer class="scroll-reveal">
      <EditorialLinkList items={pressLinks} emptyMessage={l.listForthcoming} />
    </EditorialListContainer>
  </div>
</section>

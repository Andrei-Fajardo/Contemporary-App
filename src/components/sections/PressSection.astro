---
import EditorialLinkList from '../EditorialLinkList.astro';
import EditorialListContainer from '../EditorialListContainer.astro';
import { pressLinks } from '../../data/content';
import { t, type LocaleKey } from '../../data/translations';

interface Props {
  locale?: LocaleKey;
}

const { locale = 'en' } = Astro.props;
const l = t[locale];
---

<section id="press" class="scroll-section section-gap press-overlap editorial-panel">
  <div class="press-overlap__content section-shell section-shell--wide">
    <header class="editorial-panel__masthead scroll-reveal">
      <p class="editorial-panel__eyebrow">{l.pressTag}</p>
      <h2 class="editorial-panel__title">{l.nav.press}</h2>
    </header>
    {/* Press headlines are published titles — kept as authored English */}
    <div class="editorial-index editorial-index--stagger">
      <EditorialListContainer class="scroll-reveal">
        <EditorialLinkList items={pressLinks} emptyMessage={l.listForthcoming} />
      </EditorialListContainer>
    </div>
  </div>
</section>

---
import EditorialLinkList from '../EditorialLinkList.astro';
import { researchLinks } from '../../data/content';
import { t, type LocaleKey } from '../../data/translations';

interface Props {
  locale?: LocaleKey;
}

const { locale = 'en' } = Astro.props;
const l = t[locale];
---

<section id="research" class="v2-chapter scroll-section research-section">
  <div class="v2-wrap">
    <header class="v2-art__head">
      <h2 class="v2-title scroll-reveal">{l.academicHeading}</h2>
    </header>

    <div class="editorial-index scroll-reveal" style="margin-top: clamp(1.5rem, 4vh, 2.75rem);">
      <EditorialLinkList items={researchLinks} emptyMessage={l.listForthcoming} showYear={false} />
    </div>
  </div>
</section>

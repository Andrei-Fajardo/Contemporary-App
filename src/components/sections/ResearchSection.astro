---
import EditorialLinkList from '../EditorialLinkList.astro';
import { researchLinks } from '../../data/content';
import { t, type LocaleKey } from '../../data/translations';

interface Props {
  locale?: LocaleKey;
}

const { locale = 'en' } = Astro.props;
const l = t[locale];
---

<section id="research" class="scroll-section section-gap research-section magazine-torn">
  <div class="section-shell section-shell--wide">
    <div class="magazine-chapter scroll-reveal">
      <p class="section-eyebrow">{l.academicTag}</p>
      <h2 class="magazine-chapter__title text-2xl md:text-5xl lg:text-6xl text-ink mb-3">
        {l.academicHeading}
      </h2>
      <hr class="magazine-rule-crimson magazine-rule-crimson--short" />
    </div>

    <div class="editorial-index scroll-reveal">
      {/* Link titles are proper nouns / published headlines — kept as authored English */}
      <EditorialLinkList items={researchLinks} emptyMessage={l.listForthcoming} />
    </div>
  </div>
</section>

---
import EditorialLinkList from '../EditorialLinkList.astro';
import { researchLinks } from '../../data/content';
import { t, type LocaleKey } from '../../data/translations';

interface Props {
  locale?: LocaleKey;
}

const { locale = 'en' } = Astro.props;
const l = t[locale];
---

<section id="research" class="scroll-section section-gap research-section editorial-panel">
  <div class="section-shell section-shell--wide">
    <header class="editorial-panel__masthead scroll-reveal">
      <p class="editorial-panel__eyebrow">{l.academicTag}</p>
      <h2 class="editorial-panel__title">{l.academicHeading}</h2>
    </header>

    <div class="editorial-index editorial-index--stagger">
      {/* Link titles are proper nouns / published headlines — kept as authored English */}
      <EditorialLinkList items={researchLinks} emptyMessage={l.listForthcoming} />
    </div>
  </div>
</section>

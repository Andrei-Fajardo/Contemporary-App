---
import MediaPopup from '../MediaPopup.astro';
import { t, type LocaleKey } from '../../data/translations';
import { artworks } from '../../data/artworks';

interface Props {
  locale?: LocaleKey;
}

const { locale = 'en' } = Astro.props;
const l = t[locale];
---

<section id="art" class="v2-chapter scroll-section">
  <div class="v2-wrap">
    <header class="v2-art__head">
      <h2 class="v2-title scroll-reveal">{l.nav.art}</h2>
      <p class="v2-lede scroll-reveal">{l.artistCredit}</p>
    </header>

    <div class="v2-art__grid">
      {artworks.map((p) => (
        <article class="v2-art__item scroll-reveal" data-popup-title={p.title}>
          <div class="v2-bezel">
            <div class="v2-bezel__inner v2-art__media v2-scale-media">
              <MediaPopup
                imageSrc={p.image}
                imageAlt={p.title}
                title={p.title}
                subtitle={p.dimensions}
                aspectRatio={p.contain ? "auto" : "3 / 2"}
                parallaxSpeed={0}
                contain={p.contain}
                eager={true}
                imageClass={p.contain ? "w-full h-auto max-h-[80vh] object-contain mx-auto" : "w-full h-[48vh] md:h-[58vh] object-cover"}
              />
            </div>
          </div>

          <div class="v2-art__meta">
            <h3>{p.title}</h3>
            <p>{p.dimensions}</p>
            <div class="v2-art__body">
              <div class="hidden md:block">
                {p.aboutParagraphs.map((para) => (
                  <p>{para}</p>
                ))}
              </div>
              <div class="block md:hidden">
                <p>{p.aboutMobile}</p>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .v2-art__item :global(.media-card-caption) {
    display: none;
  }

  .v2-art__item :global(.media-card),
  .v2-art__item :global(.cursor-tilt),
  .v2-art__item :global(.cursor-tilt__surface),
  .v2-art__item :global(.lazy-media) {
    border-radius: inherit;
    overflow: hidden;
  }
</style>

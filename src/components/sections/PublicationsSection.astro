---
import EditorialLinkList from '../EditorialLinkList.astro';
import EditorialListContainer from '../EditorialListContainer.astro';
import ManuscriptModal from '../ManuscriptModal.astro';
import { publicationLinks } from '../../data/content';
import { siteCopy } from '../../data/site-copy';
import { t, type LocaleKey } from '../../data/translations';

interface Props {
  locale?: LocaleKey;
}

const { locale = 'en' } = Astro.props;
const l = t[locale];
const novels = siteCopy.publications.novels;
const pubsHeadingParts = l.publicationsHeading.split(/\s*&\s*/);
const pubsHeadingHasAmp = pubsHeadingParts.length === 2;
---

<section id="publications" class="scroll-section section-gap pubs-overlap magazine-torn">

  <div class="pubs-overlap__frame" aria-hidden="true">
    <img
      src="/media/anan sample 2.png"
      alt=""
      class="pubs-overlap__img"
      loading="lazy"
      decoding="async"
      draggable="false"
      data-lightbox-ignore
      data-artwork-parallax
      data-artwork-strength="0.035"
      data-artwork-max="18"
    />
  </div>

  <div class="pubs-overlap__content section-shell section-shell--wide">
    <header class="pubs-editorial__masthead scroll-reveal">
      <div class="magazine-chapter">
        <p class="section-eyebrow">{l.publicationsTag}</p>
        <h2 class="magazine-chapter__title pubs-overlap__heading">
          {pubsHeadingHasAmp ? (
            <>
              <span class="pubs-heading__part">{pubsHeadingParts[0]}</span>
              <span class="pubs-heading__amp">&amp;</span>
              <span class="pubs-heading__part">{pubsHeadingParts[1]}</span>
            </>
          ) : (
            l.publicationsHeading
          )}
        </h2>
      </div>
      <p class="content-prose text-ink-60 pubs-section__intro">
        {l.publicationsIntro}
      </p>
    </header>

    <div class="editorial-list-blocks scroll-reveal">
      <div class="editorial-list-block">
        <h3 class="editorial-list-block__label">{l.chapbookLabel}</h3>
        <EditorialListContainer>
          <div class="pubs-section__manuscript-actions" role="group" aria-label={l.manuscriptHeading}>
            <button type="button" class="pubs-manuscript-btn animate-pulse-cta" data-manuscript-open>
              {l.manuscriptReadBtn}
            </button>
          </div>
        </EditorialListContainer>
      </div>

      <div class="editorial-list-block">
        <h3 class="editorial-list-block__label">{l.publicationsFeaturedLabel}</h3>
        {/* Publication titles are proper nouns / published names — kept as authored English */}
        <EditorialListContainer>
          <EditorialLinkList items={publicationLinks} showYear={false} emptyMessage={l.listForthcoming} />
        </EditorialListContainer>
      </div>

      {novels.length > 0 && (
        <div class="editorial-list-block">
          <h3 class="editorial-list-block__label">{l.novelsLabel}</h3>
          <EditorialListContainer>
            <ul class="pubs-novel-list">
              {novels.map((novel) => (
                <li class="pubs-novel-list__item">
                  <span class="editorial-row-list__title">{novel.title === 'Untitled Novel' ? l.untitledNovel : novel.title}</span>
                  {novel.status === 'coming-soon' && (
                    <span class="pubs-novel-list__status">{l.comingSoon}</span>
                  )}
                </li>
              ))}
            </ul>
          </EditorialListContainer>
        </div>
      )}
    </div>
  </div>

</section>

<ManuscriptModal locale={locale} />

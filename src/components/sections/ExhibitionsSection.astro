---
import ExhibitionAccordion from '../ExhibitionAccordion.astro';
import ExhibitionGalleryOverlay from '../ExhibitionGalleryOverlay.astro';
import { t, type LocaleKey } from '../../data/translations';
import { exhibitionEntries } from '../../data/content';
import { sortExhibitionEntries } from '../../data/exhibition-display';

interface Props {
  locale?: LocaleKey;
}

const { locale = 'en' } = Astro.props;
const l = t[locale];
// Magazines belong in Publications — one flat exhibitions list, no category UI
const showEntries = exhibitionEntries.filter((entry) => entry.category !== 'magazine');
const sortedExhibitions = sortExhibitionEntries(showEntries);
---

<section id="exhibitions" class="scroll-section section-gap editorial-panel">
  <div class="section-shell section-shell--wide magazine-chapter">
    <header class="editorial-panel__masthead scroll-reveal">
      <p class="editorial-panel__eyebrow">{l.exhibitionsTag}</p>
      <h2 class="editorial-panel__title" set:html={l.exhibitionHistory}></h2>
      <p class="editorial-panel__intro content-prose text-ink-60">
        {l.exhibitionsIntro}
      </p>
    </header>

    {/* Exhibition titles, venues, and places are proper nouns — not translated */}
    <ExhibitionAccordion entries={sortedExhibitions} expandLabel={l.viewMore} locale={locale} />
  </div>
</section>

{/* Gallery overlay — rendered once, shown/hidden via JS */}
<ExhibitionGalleryOverlay locale={locale} />

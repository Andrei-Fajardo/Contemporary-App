---
import ExhibitionAccordion from '../ExhibitionAccordion.astro';
import ExhibitionGalleryOverlay from '../ExhibitionGalleryOverlay.astro';
import { t, type LocaleKey } from '../../data/translations';
import { exhibitionEntries } from '../../data/content';
import { sortExhibitionEntries } from '../../data/exhibition-display';

interface Props {
  locale?: LocaleKey;
}

const { locale = 'en' } = Astro.props;
const l = t[locale];
const sortedExhibitions = sortExhibitionEntries(exhibitionEntries);
---

<section id="exhibitions" class="v2-chapter scroll-section">
  <div class="v2-wrap">
    <header class="v2-art__head">
      <h2 class="v2-title scroll-reveal" set:html={l.exhibitionHistory} />
      <p class="v2-lede scroll-reveal">{l.exhibitionsIntro}</p>
    </header>

    <div class="scroll-reveal" style="margin-top: clamp(1.5rem, 4vh, 2.75rem);">
      <ExhibitionAccordion entries={sortedExhibitions} expandLabel={l.viewMore} locale={locale} />
    </div>
  </div>
</section>

<ExhibitionGalleryOverlay locale={locale} />

---
import { t, type LocaleKey } from '../data/translations';

interface Props {
  locale?: LocaleKey;
}

const { locale = 'en' } = Astro.props;
const l = t[locale];
---

<footer class="v2-footer v2-wrap">
  <div class="v2-footer__row">
    <a href="mailto:contact@annadauylrockswell.com">contact@annadauylrockswell.com</a>
    <a href="https://instagram.com/rockswellnana" target="_blank" rel="noopener noreferrer">@rockswellnana</a>
  </div>
  <p class="v2-footer__copy">{l.copyright}</p>
</footer>

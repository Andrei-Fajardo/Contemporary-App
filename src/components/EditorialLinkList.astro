---
import type { LinkItem } from '../data/content';

interface Props {
  items: LinkItem[];
  emptyMessage?: string;
  showYear?: boolean;
}

const { items, emptyMessage = 'List forthcoming', showYear = true } = Astro.props;
// Prefer callers passing `emptyMessage` from `t[locale].listForthcoming`.
const listClass = showYear
  ? 'editorial-link-list editorial-row-list editorial-row-list--platform scroll-reveal'
  : 'editorial-link-list editorial-row-list editorial-row-list--no-year editorial-row-list--platform scroll-reveal';
---

{items.length > 0 ? (
  <ul class={listClass}>
    {items.map((item) => (
      <li class="editorial-row-list__item hover-row">
        {showYear && <span class="editorial-row-list__year">{item.year ?? ''}</span>}
        <div class="editorial-row-list__copy">
          {item.href ? (
            <a href={item.href} target="_blank" rel="noopener noreferrer" class="editorial-row-list__title">
              {item.title}
            </a>
          ) : (
            <span class="editorial-row-list__title">{item.title}</span>
          )}
          {item.platform && (
            item.platformHref ? (
              <a
                href={item.platformHref}
                target="_blank"
                rel="noopener noreferrer"
                class="editorial-row-list__platform"
              >
                {item.platform}
              </a>
            ) : (
              <span class="editorial-row-list__platform editorial-row-list__platform--plain">
                {item.platform}
              </span>
            )
          )}
        </div>
      </li>
    ))}
  </ul>
) : (
  <p class="scroll-reveal content-prose text-ink-55">{emptyMessage}</p>
)}

---
import { t, type LocaleKey } from '../data/translations';

interface Props {
  locale?: LocaleKey;
}

const { locale = 'en' } = Astro.props;
const l = t[locale];

const roleBits = l.heroRoles.split(',').map((s) => s.trim()).filter(Boolean);
const marqueeItems = [...roleBits, ...roleBits];
---

<section id="home" class="v2-hero scroll-section">
  <div class="v2-wrap v2-hero__grid">
    <div class="v2-hero__copy">
      <p class="v2-kicker scroll-reveal">{l.heroTagline}</p>
      <h1 class="v2-hero__name scroll-reveal">
        <span>{l.heroFirstName}</span>
        <span>{l.heroLastName}</span>
      </h1>

      <div class="v2-hero__roles-marquee scroll-reveal" aria-hidden="true">
        <div class="v2-hero__marquee-track">
          {marqueeItems.map((role) => (
            <span class="v2-hero__marquee-item">
              {role}
              <span class="v2-hero__marquee-dot">·</span>
            </span>
          ))}
        </div>
      </div>

      <p class="v2-hero__lede scroll-reveal">{l.heroBasedIn}</p>

      <div class="v2-hero__actions scroll-reveal">
        <a class="v2-cta" href="#art">
          {l.viewPaintings}
          <span class="v2-cta__icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M7 17L17 7M17 7H9M17 7V15" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
        <a class="v2-cta v2-cta--ghost" href="#exhibitions">
          {l.viewExhibitions}
          <span class="v2-cta__icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M7 17L17 7M17 7H9M17 7V15" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      </div>
    </div>

    <div class="v2-hero__visual scroll-reveal">
      <div class="v2-bezel v2-scale-media">
        <div class="v2-bezel__inner">
          <img
            src="/media/anna%20header%202.png"
            alt={l.siteTitle}
            loading="eager"
            decoding="async"
            draggable="false"
            data-lightbox-ignore
          />
        </div>
      </div>
    </div>
  </div>
</section>

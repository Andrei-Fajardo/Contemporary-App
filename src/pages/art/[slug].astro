---
import StudioLayout from '../../layouts/StudioLayout.astro';
import { t } from '../../data/translations';
import { artworks } from '../../data/artworks';
import { imageSeoSlots } from '../../data/image-seo-slots';

export async function getStaticPaths() {
  return artworks.map((art) => ({
    params: { slug: art.slug },
  }));
}

const l = t.en;
const painting = artworks.find((a) => a.slug === Astro.params.slug);

if (!painting) {
  return Astro.redirect('/404');
}

const artworkImageSlot = imageSeoSlots.artworks[painting.slug];
// TODO(client-images): pending final image approval — alt/og remain empty until client provides copy
const artworkAlt = artworkImageSlot?.alt || painting.title;
const artworkOg = artworkImageSlot?.ogImage ?? '';

const others = artworks.filter((a) => a.slug !== painting.slug);
---

<StudioLayout
  title={`${painting.title} — ${l.siteTitle}`}
  active="art"
  seoPage="artwork"
  seoDescription={painting.aboutMobile || painting.aboutParagraphs[0]}
  ogImage={artworkOg}
  artwork={painting}
>
  <section class="st-page">
    <div class="pt-10 md:pt-14 st-reveal">
      <a href="/art" class="text-sm font-medium text-[var(--st-ink-dim)] hover:text-[var(--st-ink)] transition-colors">&larr; Art</a>
    </div>

    <div class="mt-10 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <div class="lg:col-span-6 st-reveal min-w-0">
        <div class="st-media st-media--portrait">
          <div class="st-frame st-frame--portrait">
            <img src={painting.image} alt={artworkAlt} loading="eager" />
          </div>
        </div>
      </div>
      <div class="lg:col-span-6 lg:sticky lg:top-16 min-w-0" data-reveal-group>
        <h1 class="st-display st-reveal text-[clamp(2rem,4.5vw,3.2rem)]">{painting.title}</h1>
        <p class="st-reveal mt-4 text-sm text-[var(--st-ink-dim)]">
          {painting.medium.toLowerCase()} · {painting.dimensions} · {painting.year}
        </p>
        <p class="st-reveal mt-2 text-sm text-[var(--st-ink-faint)]">{l.artistCredit}</p>
        <div class="st-reveal st-prose mt-7 space-y-4">
          {painting.aboutParagraphs.map((para) => <p>{para}</p>)}
        </div>
      </div>
    </div>

    {others.length > 0 && (
      <div class="mt-20 md:mt-28">
        <h2 class="st-display st-reveal text-[clamp(1.5rem,2.8vw,2.1rem)]">More Work</h2>
        <div class="mt-8 grid grid-cols-2 lg:grid-cols-3 gap-5 md:gap-8" data-reveal-group>
          {others.map((art) => (
            <a href={`/art/${art.slug}`} class="st-reveal block min-w-0">
              <div class="st-media st-media--portrait">
                <div class="st-frame st-frame--portrait">
                  <img src={art.image} alt={art.title} loading="lazy" />
                </div>
              </div>
              <p class="st-caption"><b>{art.title}</b> · {art.year}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
</StudioLayout>
